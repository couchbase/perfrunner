[test_case]
test = perfrunner.tests.analytics.IncrementalSyncTest

[showfast]
title = 4 nodes, BigFUN 20M users (320M docs), no indexes, s=1 c=99, Remote Link, Capella Columnar
component = analyticscloud
category = sync
sub_category = {provider}

[stats]
server_processes = java

[cluster]
num_buckets = 1
enable_n2n_encryption = all

[bucket]
backend_storage = magma
eviction_policy = fullEviction

[collection]
config = collections/1bucket_1scope_99collections_analytics.json

[analytics]
dataset_conf_file = tests/analytics/config/bigfun_99_to_99_datasets_remote.yaml
couchbase_link_name = RemoteLink

[backup]
obj_staging_dir = /stage
obj_region = us-east-1
aws_credential_path = /root/.ssh

[restore]
backup_storage = s3://analytics-bigfun20m-99collections/columnar
backup_repo = default
threads = 8
map_data = bucket-1.scope-1=bucket-1.scope-1
