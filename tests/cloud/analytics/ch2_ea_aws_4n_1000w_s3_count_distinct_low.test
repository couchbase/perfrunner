[test_case]
test = perfrunner.tests.analytics.CustomQueryTest
passes = 5

[showfast]
title = CH2 1000W, 4A, COUNT(DISTINCT) low complexity, sort-merge baseline vs hash aggregation
component = analyticscloud
category = ch2
sub_category = {provider}

[stats]
server_processes = java

[cluster]
mem_quota = 100
analytics_mem_quota = 25600
initial_nodes = 4
num_buckets = 1
bucket_name = bench

[analytics]
dataset_conf_file = tests/analytics/config/ch2_11_to_11_datasets_standalone_uniform_pk.yaml
custom_query_conf_file = perfrunner/workloads/analytics/custom/ch2_count_distinct_low.yaml
aws_credential_path = /root/.ssh/
use_cbo = true
cbo_sample_size = high

[analytics_external_data]
link_type = s3
region = us-east-1
obj_store_name = analytics-ch2-1000w-gz
file_format = json
file_include = *.gz
