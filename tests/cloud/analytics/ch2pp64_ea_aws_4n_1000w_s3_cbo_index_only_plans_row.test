[test_case]
test = perfrunner.tests.analytics.CustomQueryTest

[showfast]
title = CH2++64 1000W, 4A, c=2 (standalone collections), CBO (high sample size), Index-only Plans Custom Queries, row storage
component = analyticscloud
category = ch2
sub_category = {provider}

[stats]
server_processes = java

[cluster]
mem_quota = 100
analytics_mem_quota = 25600
initial_nodes = 4
num_buckets = 1
bucket_name = bench

[analytics]
use_cbo = true
cbo_sample_size = high
dataset_conf_file = tests/analytics/config/ch2_11_to_11_datasets_standalone_specific_pk.yaml
custom_query_conf_file = perfrunner/workloads/analytics/custom/ch2pp_index_only_plans.yaml
storage_format = row

[analytics_external_data]
link_type = s3
region = us-east-1
obj_store_name = analytics-ch2pp64-1000w-gz
file_format = json
file_include = *.gz

[columnar]
object_store_import_datasets = customer, orders
