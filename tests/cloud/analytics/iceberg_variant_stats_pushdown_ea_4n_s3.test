[test_case]
test = perfrunner.tests.analytics.IcebergVariantTest
passes = 5
query_retries = 2

[showfast]
title = 4 nodes, Iceberg Variant, stats pushdown and predicate classes on prunable layout
component = analyticscloud
category = iceberg
sub_category = {provider}

[stats]
server_processes = java

[cluster]
mem_quota = 100
analytics_mem_quota = 25600
initial_nodes = 4
num_buckets = 1
bucket_name = bench

[analytics]
dataset_conf_file = tests/analytics/config/iceberg_variant_datasets.yaml
custom_query_conf_file = perfrunner/workloads/analytics/custom/iceberg_variant_stats_pushdown.yaml
aws_credential_path = /root/.ssh/
icebergVariantEnabled = true

[analytics_external_data]
link_type = s3
region = us-east-1
catalog_name = variant_glue
