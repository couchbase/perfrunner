[test_case]
test = perfrunner.tests.secondary.CloudSecondaryIndexingScanReportTest

[showfast]
title = GSI Scan Report | Feature OFF (baseline) | Single node, 16 workers | 10M x 1KB | 1 plasma index
category = lat
component = secondarycloud
sub_category = {provider}

[cluster]
initial_nodes = 8
num_buckets = 1
enable_cpu_cores = false
enable_n2n_encryption = all
ui_http = disabled

[bucket]
replica_number = 1
replica_index = 0
eviction_policy = fullEviction
backend_storage = magma

[load]
items = 10000000
size = 1024
workers = 100
ssl_mode = capella

[secondary]
indexes = myindex:alt_email
indexer.settings.storage_mode = plasma
indexer.settings.generateScanReport = false
scan_report_query = SELECT meta().id FROM `bucket-1` WHERE alt_email IS NOT NULL LIMIT 100
scan_report_wait_ms = 0
scan_report_use_profile_timings = false
scan_report_workers = 16
scan_report_iterations = 10000

[access]
creates = 10
updates = 80
deletes = 10
items = 10000000
workers = 40
throughput = 30000
time = 300
ssl_mode = capella
