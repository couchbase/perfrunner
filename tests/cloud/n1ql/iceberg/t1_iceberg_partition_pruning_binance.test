[test_case]
test = perfrunner.tests.n1ql.N1QLExternalIcebergTest

[showfast]
title = Iceberg partition pruning (Binance trades), p90 latency (ms)
component = n1qlcloud
category = iceberg
sub_category = {provider}

[cluster]
mem_quota = 10000
index_mem_quota = 2000
initial_nodes = 5
num_buckets = 1
bucket_name = default
enable_cpu_cores = false
enable_n2n_encryption = all
ui_http = disabled

[bucket]
replica_number = 1
eviction_policy = fullEviction
backend_storage = magma

[query_external_data]
region = us-east-1
aws_credential_path = /root/.ssh
catalog_name = binance_glue
collections_file = collections/external/binance_trades.json

[load]
items = 1000000
size = 1024
workers = 0
doc_gen = reverse_lookup
ssl_mode = capella

[access]
creates = 0
reads = 0
updates = 0
deletes = 0
workers = 0
items = 1000000
time = 2400
latency_percentiles = 90
n1ql_queries = partition-pruned
n1ql_workers = 4
n1ql_timeout = 900
workload_instances = 1
ssl_mode = capella

[n1ql-partition-pruned]
statement = RAW_QUERY SELECT t.trade_id, t.price, t.qty, t.trade_time FROM default.iceberg.trades AS t WHERE t.symbol = "BTCUSDT" AND t.trade_time >= 1704067200000000 AND t.trade_time < 1706745600000000 LIMIT 100;
scan_consistency = not_bounded
args = []
