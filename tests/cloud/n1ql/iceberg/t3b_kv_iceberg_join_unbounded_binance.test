[test_case]
test = perfrunner.tests.n1ql.N1QLExternalIcebergJoinTest

[showfast]
title = KV + Iceberg JOIN BTC/ETH 2mo (Binance), p90 latency (ms) [baseline]
component = n1qlcloud
category = iceberg
sub_category = {provider}

[cluster]
mem_quota = 10000
index_mem_quota = 2000
initial_nodes = 5
num_buckets = 1
bucket_name = default
enable_cpu_cores = false
enable_n2n_encryption = all
ui_http = disabled

[bucket]
replica_number = 1
eviction_policy = fullEviction
backend_storage = magma

[collection]
config = collections/1bucket_1scope_instrument_iceberg.json

[index]
statements =
    CREATE PRIMARY INDEX ON default:`default`.`local`.`instrument`;

[query_external_data]
region = us-east-1
aws_credential_path = /root/.ssh
catalog_name = binance_glue
collections_file = collections/external/binance_trades_serial_scan.json
instrument_import_file = tests/cloud/n1ql/iceberg/etl/instrument_214.json

[load]
items = 4000
size = 1024
workers = 0
doc_gen = reverse_lookup
ssl_mode = capella

[access]
creates = 0
reads = 0
updates = 0
deletes = 0
workers = 0
items = 4000
time = 3600
latency_percentiles = 90
n1ql_queries = join-unbounded
n1ql_workers = 1
n1ql_timeout = 1800
workload_instances = 1
ssl_mode = capella

[n1ql-join-unbounded]
statement = RAW_QUERY SELECT i.symbol, i.baseAsset, t.price, t.qty, t.trade_time FROM default.local.instrument AS i JOIN default.iceberg.trades AS t ON t.symbol = i.symbol WHERE i.quoteAsset = "USDT" AND i.baseAsset IN ["BTC", "ETH"] AND t.qty > 100 AND t.trade_time >= 1704067200000000 AND t.trade_time < 1709251200000000;
scan_consistency = not_bounded
args = []
