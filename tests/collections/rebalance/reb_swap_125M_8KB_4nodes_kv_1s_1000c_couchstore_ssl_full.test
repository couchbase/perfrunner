[test_case]
test = perfrunner.tests.rebalance.RebalanceKVTest

[showfast]
title = Rebalance-swap (min), 4 -> 4, 125M x 8KB, 15K ops/sec (90/10 R/W), 10%% cache miss rate, s=1, c=1000, Couchstore, Full Eviction, N2N=Strict
component = reb
category = kv
sub_category = DGM

[cluster]
mem_quota = 51200
initial_nodes = 4
num_buckets = 1
kernel_mem_limit = 65G
kernel_mem_limit_services = kv
enable_n2n_encryption = strict

[bucket]
eviction_policy = fullEviction

[collection]
config = collections/1bucket_1scope_1000collections_basic.json

[load]
items = 125000000
size = 8192
workers = 128
doc_gen = incompressible
ssl_mode = n2n

[hot_load]
items = 125000000
workers = 128
working_set = 5
ssl_mode = n2n

[access]
creates = 0
reads = 90
updates = 10
deletes = 0
throughput = 15000
items = 125000000
workers = 128
working_set = 5
working_set_access = 90
ssl_mode = n2n

[rebalance]
nodes_after = 4
swap = 1
start_after = 180
