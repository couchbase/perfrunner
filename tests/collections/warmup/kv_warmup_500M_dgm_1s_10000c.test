[test_case]
test = perfrunner.tests.kv.WarmupTest

[showfast]
title = Warmup time (min), 4 nodes, 1 bucket x 500M x 1KB, s=1 c=10000
component = kv
category = warmup

[cluster]
mem_quota = 51200
initial_nodes = 4
num_buckets = 1

[bucket_extras]
access_scanner_enabled = false

[stats]
interval = 1

[collection]
scopes_per_bucket = 1
collections_per_scope = 10000

[load]
items = 500000000
size = 1024
workers = 100
key_fmtr = hex
doc_gen = large

[access]
creates = 0
reads = 0
updates = 100
deletes = 0
throughput = 20000
items = 500000000
workers = 40
time = 3600
