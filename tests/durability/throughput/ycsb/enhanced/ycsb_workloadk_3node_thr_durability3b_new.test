[test_case]
test = perfrunner.tests.ycsb.YCSBThroughputTest

[showfast]
title = Avg Throughput (ops/sec), SDK 3, Durability Persist Majority, 3 nodes, Update Only
component = kv
category = durability
sub_category = Throughput
orderby = a31

[cluster]
mem_quota = 40960
initial_nodes = 3
num_buckets = 1

[bucket]
replica_number = 2
eviction_policy = fullEviction
backend_storage = magma

[load]
workload_path = workloads/workloadk
items = 20000000
workers = 128
ycsb_client = couchbase3

[access]
durability = 3
workload_path = workloads/workloadk
items = 20000000
ops = 0
time = 1200
workers = 512
workload_instances = 6
ycsb_client = couchbase3
enable_mutation_token = true
kv_endpoints = 256

[ycsb]
branch = couchbase3
