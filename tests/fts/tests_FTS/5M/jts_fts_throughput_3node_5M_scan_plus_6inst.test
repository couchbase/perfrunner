[test_case]
test = perfrunner.tests.fts.FTSThroughputLoadTest

[showfast]
title = Med Term Throughput, scan_plus, 1.5K KV w/sec, 5M docs, 3 node, 6 inst, FTS
component = jts
category = 1M
sub_category = Throughput
orderby = q0b00001001

[cluster]
mem_quota = 51024
initial_nodes = 3
num_buckets = 1
fts_index_mem_quota = 20000

[load]
items = 5000000
workers = 10
doc_gen = fts_doc
fts_data_spread_workers = 100

[collection]
config = collections/1bucket_1scope_1collection_basic.json

[jts]
jts_instances = 6
logging_method = bucket_wise
jts_repo_branch = multi_query_support
test_duration = 600
test_total_docs = 5000000
test_query_workers = 10
test_kv_workers = 10
test_kv_throughput_goal = 250
test_driver = couchbase
test_stats_limit = 1000000
test_stats_aggregation_step = 100
test_debug = false
test_data_file = ../tests/fts/data/benchmark/med.txt
test_worker_type = validatedThroughput
couchbase_index_name = perf_fts_index
couchbase_index_configfile = tests/fts/index/fts_tvectors_off_3pindexes.json
test_mutation_field = text2
test_query_type = term
test_query_limit = 10
test_query_field = text
scan_consistency = scan_plus
report_percentiles = 80,95,99
