[test_case]
test = perfrunner.tests.fts.FTSIndexTest

[showfast]
title = Index build time, initial (sec), wiki 1M x 1KB, 3 node, FTS, 1000 collections per index, s=1 c=10000 i=10
component = jts
category = 1M
sub_category = Index
orderby = q0b00000000

[cluster]
mem_quota = 51024
initial_nodes = 3
num_buckets = 1
fts_index_mem_quota = 20000

[collection]
scopes_per_bucket = 1
collections_per_scope = 10000

[load]
items = 1000000
fts_data_spread_workers = 100

[jts]
jts_repo_branch = SDK3
test_total_docs = 1000000
couchbase_index_name = perf_fts_index
index_groups = 10
indexes_per_group = 1
couchbase_index_configfile = tests/fts/index/fts_tvectors_off.json

[restore]
backup_storage =  /fts/backup
backup_repo =  fts_wiki

[profiling]
services = fts
