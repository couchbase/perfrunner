[test_case]
test = perfrunner.tests.secondary.InitialVectorSecondaryIndexTest

[showfast]
title = Memory Footprint (RaBitQ), LAION 100M 768d, no replica, Composite
sub_category = Plasma
component = secondary
category = vector

[stats]
use_prometheus_metrics = true
server_processes = projector

[cluster]
mem_quota = 100000
index_mem_quota = 117760
initial_nodes = 4
num_buckets = 1
online_cores = 32

[compaction]
db_percentage = 100
view_percentage = 100

[bucket]
replica_number = 0
replica_index = 0
backend_storage = magma
eviction_policy = fullEviction

[collection]
config = collections/1bucket_1scope_1collection_basic_default.json

[load]
items = 100000000
size = 1024
workers = 50
key_fmtr = no_hash
doc_gen = vector_embedding

[secondary]
indexes = tests/gsi/index_defs/1bucket_1scope_1collections_1_vector_index_laion_100m_768d_rabitq.json
indexer.settings.storage_mode = plasma
vector_dimension = 768
vector_description = IVF,RaBitQ
vector_similarity = L2_SQUARED
run_recovery_test = 0
indexer.settings.max_cpu_percent = 3200

[restore]
backup_storage = s3://laion-dataset-100m-768-dims
backup_repo = laion-dataset-100m-768-dims
threads = 50

[backup]
obj_staging_dir = /stage
obj_region = us-east-1
aws_credential_path = /root/.ssh

[bucket_extras]
num_writer_threads = disk_io_optimized
num_reader_threads = disk_io_optimized
