[test_case]
test = perfrunner.tests.n1ql.N1qlHybridSearchTest

[showfast]
title = Hybrid Search, WANDS 43K, RRF dense+attribute-sparse, k=60, bhive cluster 1 index node (Exact-only GT)
component = n1ql
category = vector
sub_category = Hybrid_RRF

[stats]
server_processes = projector

[cluster]
mem_quota = 96000
index_mem_quota = 96000
initial_nodes = 4
num_buckets = 1
online_cores = 16

[bucket]
backend_storage = magma
eviction_policy = fullEviction

[collection]
config = collections/1bucket_1scope_1collection_basic_default.json

[secondary]
indexes = tests/n1ql/hybrid/index_defs/dense_768d_bhive_index.json
indexer.settings.storage_mode = plasma
vector_dimension = 768
vector_def_prefix = emb
vector_similarity = COSINE
vector_index_type = bhive
vector_reranking = true
vector_scan_probes = 200
vector_description = 'IVF,SQ8'
#  ---- hybrid / RRF fusion via reciprocal_fusion(): dense (BGE) + attribute sparse ----
retrieval_mode = hybrid_rrf
query_map_s3_path = s3://hybrid-dense-msmarco/queries/
rrf_constant = 60
rrf_weights = 3,1
fusion_candidate_depth = 500
rrf_output_id_field = id
fusion_type = unionall
fusion_scorer = rrf
#  Attribute sparse leg: sparsejl_dim=14929 (WANDS vocab), IVF200 ~ sqrt(43K); rsf if margin thin.
sparse_vector_field = sparse
sparse_index_name = sparse-idx
sparse_description = IVF200
sparsejl_dim = 14929
sparse_query_literal_format = raw
sparse_topn_scan = 100
sparse_scan_probes = 200
sparse_query_path = tests/n1ql/hybrid/data/wands_sparse_queries.txt

[restore]
backup_storage = s3://hybrid-dense-msmarco
#  WANDS corpus (docs = id/emb/sparse), wands_hybrid repo, restored as bucket-1.
backup_repo = wands_hybrid
map_data = wands=bucket-1
threads = 50

[backup]
obj_staging_dir = /stage
obj_region = us-east-1
aws_credential_path = /root/.ssh

[index]
indexes_path = tests/n1ql/hybrid/index_defs/dense_768d_bhive_index.json
vector_query_path = tests/n1ql/hybrid/data/wands_dense_queries_768d.txt
top_k_results = 100
ground_truth_file_name = wands/wands_ground_truth_exact.txt
ground_truth_s3_path = s3://atlas-fts-backup/VectorGroundTruthFiles/

[load]
items = 42994
doc_gen = hybrid_vector_embedding

[access]
items = 42994
workers = 0
time = 600
n1ql_op = read
latency_percentiles = 50,90,95,99
n1ql_query_type = Vector
n1ql_workers = 32
workload_instances = 1
vector_query_path = tests/n1ql/hybrid/data/wands_dense_queries_768d.txt
doc_gen = hybrid_vector_embedding
n1ql_queries = q01

[n1ql-q01]
statement = SELECT RAW f.id FROM reciprocal_fusion(RRF_OPTIONS, (SELECT RAW {"id":META(d).id} FROM `TARGET_BUCKET` AS d ORDER BY ANN_DISTANCE(d.emb, $1, 'SIMILARITY', DENSE_NPROBES, RERANKING, DENSE_TOPNSCAN) LIMIT CANDIDATE_DEPTH), (SELECT RAW {"id":META(s).id} FROM `TARGET_BUCKET` AS s ORDER BY SPARSE_VECTOR_DISTANCE(s.sparse, $2, SPARSE_NPROBES, SPARSE_TOPNSCAN) LIMIT CANDIDATE_DEPTH)) AS f
args = [{emb},{sparse}]
total_batches = 1000
ad_hoc = true
